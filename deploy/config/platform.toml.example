# /etc/kirocrew-on/platform.toml —— 平台（OS 用户 octopus），由 deploy/install/al2023.sh 生成
data_dir = "/var/lib/octopus/platform"
log_dir = "/var/log/kirocrew-on"
# 只有 CloudFront 能经安全组访问该端口；平台另外校验 X-Origin-Verify（D16）
api_host = "0.0.0.0"
api_port = 8918
# 安装脚本写入 CloudFront 分发域名，例如 ["d111111abcdef8.cloudfront.net"]
allowed_hosts = []
origin_secret_file = "/etc/kirocrew-on/origin-secret"
engine_workers = 4
retry_unavailable = 2.0
shutdown_grace = 30.0
