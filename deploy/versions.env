# 固定的来源与版本。KiroCrew 来自官方仓库最新源码，部署时锁定到下列 commit（D18）；
# 已在本机 macOS 完成原生契约与真实运行验证（docs/handover/M1-LOCAL-EVIDENCE.md）：版本 0.10.0。
KIROCREW_GIT_URL=https://github.com/kirodotdev/KiroCrew.git
KIROCREW_GIT_REF=57df464b2b4ce3fe4e71d108281ff6c3ad22c40f
KIROCREW_ACCEPTED_VERSION=0.10.0
# kiro-cli：官方发布清单解析版本并校验 sha256；latest 表示接受清单当前版本，实际版本记录在安装日志。
KIRO_CLI_VERSION=latest
# EC2 实测（2026-10-11）：kiro-cli 2.29.1
# Node.js：从 nodejs.org 下载并按 SHASUMS256.txt 校验；KiroCrew 前端与 ACP 适配器需要 Node >= 22。
NODE_DIST=latest-v22.x
# EC2 实测（2026-10-11）：Node v22.23.3
# Coding 工具（macOS 本机观测值，Linux 首次安装后核对）
CLAUDE_CODE_VERSION=2.1.296
CODEX_VERSION=0.153.4
OPENCODE_VERSION=1.18.30
PYTHON_PACKAGE=python3.12
