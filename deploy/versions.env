# 固定的来源与版本。KiroCrew 来自官方仓库最新源码，部署时锁定到下列 commit（D18）；
# 已在本机 macOS 与 EC2 AL2023 完成原生契约与真实运行验证（docs/handover/M1-LOCAL-EVIDENCE.md、M1-EC2-EVIDENCE.md）：版本 0.10.0。
KIROCREW_GIT_URL=https://github.com/kirodotdev/KiroCrew.git
KIROCREW_GIT_REF=57df464b2b4ce3fe4e71d108281ff6c3ad22c40f
KIROCREW_ACCEPTED_VERSION=0.10.0
# kiro-cli：官方发布清单解析版本并校验 sha256；latest 表示接受清单当前版本，实际版本记录在安装日志。
# 不固定具体版本：清单只提供当前版本，固定后下一次发布会让全新安装以版本不一致退出。
KIRO_CLI_VERSION=latest
# EC2 实测（2026-10-11）：kiro-cli 2.29.1
# Node.js：从 nodejs.org 下载并按 SHASUMS256.txt 校验；KiroCrew 前端与 ACP 适配器需要 Node >= 22。
NODE_DIST=v22.23.3
# EC2 实测（2026-10-11）：v22.23.3（由 latest-v22.x 解析得到，固定到不可变的版本目录）
# Coding 工具（npm 固定版本；macOS 与 EC2 AL2023 实测运行通过，2026-10-11）
CLAUDE_CODE_VERSION=2.1.296
CODEX_VERSION=0.153.4
OPENCODE_VERSION=1.18.30
PYTHON_PACKAGE=python3.12
# uv（MVP 0.2.0 P2，§4.2.2）：只用在 Ubuntu 22.04（系统没有 Python 3.12），管理一份 CPython 3.12；按 GitHub 发布的 .sha256 校验，
# CPython 的下载由 uv 按它内置的哈希校验。
UV_VERSION=0.13.5
UV_SHA256_X86_64=f68d291c75783122dad58ab77def0e13f3233f358731db5d6d7e8715603b928f
UV_SHA256_AARCH64=4bb69cf95ed13f23713bb7bc09f241896ea0c75b7c557e615a20604b82f9c403
# Litestream（MVP 0.2.0，P §5.2、S31）：只装在集群版控制面主机（CONTROL_PLANE_ONLY=1），按 GitHub 发布的 checksums.txt 校验。
LITESTREAM_VERSION=0.5.17
LITESTREAM_SHA256_X86_64=cfb371176d164437ae869f8351cfde49bd1804ae71c61923f75c9cba9c9c006d
LITESTREAM_SHA256_AARCH64=f8ca4a050095c1efbda2c4365172e61bf9d955ea0d9ac42f448b52e51819baa5
